# Example only: choose the framework from your team's design.
# The backend shell starts with base dependencies and no model credentials.
FURSAH_FRAMEWORK_TRACK=

# Blank = actual request time. Optional classroom instant must include timezone.
# Classroom selection: 2026-10-18T12:00:00+03:00 (noon Asia/Riyadh).
# Copy that value for classroom use only. Keep blank for actual time.
# October dataset publications precede this instant; old Day 4 labels need review.
# See backend/README.md. Dataset dates are never rewritten.
FURSAH_EVALUATION_TIME=

FURSAH_MODEL_PROVIDER=
FURSAH_MODEL_NAME=
FURSAH_MODEL_API_KEY=
FURSAH_MODEL_BASE_URL=
# Optional: true only for a keyless OpenAI-compatible loopback server.
FURSAH_ALLOW_KEYLESS_LOCAL_MODEL=false

FURSAH_MODEL_TIMEOUT_SECONDS=40
# Enforce this total limit inside your learner workflow.
FURSAH_WORKFLOW_TIMEOUT_SECONDS=90
FURSAH_MODEL_MAX_RETRIES=1
FURSAH_MODEL_OUTPUT_RETRIES=1
FURSAH_MAX_WORKFLOW_STEPS=8

# Relative to fursah-fullstack/, regardless of the working directory.
FURSAH_DATA_DIR=data
FURSAH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FURSAH_TRACE_JSONL_PATH=

# Day 4 tracing: pip install -r requirements-observability.txt, run `phoenix serve`, then set true.
FURSAH_PHOENIX_ENABLED=false
FURSAH_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
FURSAH_PHOENIX_PROJECT=fursah
# auto = LangChain/LangGraph and/or PydanticAI if installed, else the OpenAI SDK.
FURSAH_PHOENIX_INSTRUMENT=auto
