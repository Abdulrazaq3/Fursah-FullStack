# Example only: choose the framework from your team's design.
# The backend shell starts with base dependencies and no model credentials.
FURSAH_FRAMEWORK_TRACK=

# Optional PostgreSQL DSN. Blank uses the project's .local/database.json.
# Keep credentials in backend/.env or the deployment secret store.
FURSAH_DATABASE_URL=

# Blank = actual request time. Optional classroom instant must include timezone.
# Classroom selection: 2026-10-18T12:00:00+03:00 (noon Asia/Riyadh).
# Copy that value for classroom use only. Keep blank for actual time.
# October dataset publications precede this instant; old Day 4 labels need review.
# See backend/README.md. Dataset dates are never rewritten.
FURSAH_EVALUATION_TIME=

# Optional four-record classroom integration. Requires local models and PostgreSQL.
# Historical four-record pilot; leave disabled for the full-catalog workflow.
FURSAH_DISCOVERY_PILOT_ENABLED=false

# OpenRouter request understanding. The key is backend-only.
# Store the real key only in backend/.env or deployment secrets, never the frontend.
FURSAH_MODEL_PROVIDER=openrouter
FURSAH_MODEL_NAME=google/gemini-3.8-flash
FURSAH_MODEL_API_KEY=
FURSAH_MODEL_BASE_URL=https://openrouter.ai/api/v1
# Optional: true only for a keyless OpenAI-compatible loopback server.
FURSAH_ALLOW_KEYLESS_LOCAL_MODEL=false
# off = zero API calls; shadow = observation; active = checked request plan.
FURSAH_UNDERSTANDING_MODE=active
# prepared = all supplied announcements + already saved extras in PostgreSQL.
# Use prepared together with active after backend/scripts/prepare-catalog.py --publish.
# pilot preserves the historical four-record experiment.
FURSAH_CATALOG_MODE=prepared
# Only synthetic eval runs: detailed stage outputs, never enabled by default.
FURSAH_EVAL_TELEMETRY_ENABLED=false
FURSAH_CATALOG_RETRIEVAL_LIMIT=20
# 0 = rank without an uncalibrated absolute cutoff. Source/tool/constraint checks remain.
# Calibrate any positive cutoff on the full corpus before enabling it.
FURSAH_CATALOG_MIN_RERANK_SCORE=0
FURSAH_UNDERSTANDING_SHADOW_TIMEOUT_SECONDS=5
FURSAH_UNDERSTANDING_MAX_OUTPUT_TOKENS=768

FURSAH_MODEL_TIMEOUT_SECONDS=40
# Enforce this total limit inside your learner workflow.
FURSAH_WORKFLOW_TIMEOUT_SECONDS=90
FURSAH_MODEL_MAX_RETRIES=1
FURSAH_MODEL_OUTPUT_RETRIES=1
FURSAH_MAX_WORKFLOW_STEPS=8

# Relative to fursah-fullstack/, regardless of the working directory.
FURSAH_DATA_DIR=data
FURSAH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FURSAH_TRACE_JSONL_PATH=

# Day 4 tracing: pip install -r ../evals/requirements.txt, run `phoenix serve`, then set true.
FURSAH_PHOENIX_ENABLED=false
FURSAH_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
FURSAH_PHOENIX_PROJECT=fursah
# The workflow records its own custom spans.
FURSAH_PHOENIX_INSTRUMENT=none
